              text: "4. Set `GEMINI_API_KEY` in environment variables."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. For full-stack API routes, ensure serverless proxy or deploy the Express backend to a Node.js container (e.g., Render, Railway, or Google Cloud Run)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Google Cloud Run / Docker"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "```dockerfile"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "FROM node:22-alpine"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "WORKDIR /app"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "COPY package*.json ./"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "RUN npm install"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "COPY . ."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "RUN npm run build"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "EXPOSE 3000"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CMD [\"npm\", \"run\", \"start\"]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "```"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## Academic Demonstration Walkthrough"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. Open the application at `http://localhost:3000`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. Click **\"mRNA Equity\"** or **\"Post-Quantum NIST\"** in the top bar or preset buttons to instantly inspect a pre-verified brief."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. Observe the **Metrics Bar**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Total Vetted Sources (e.g. 5 / 14 discovered)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Audited Claims (e.g. 6 claims evaluated)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Supported vs. Contradicted claims breakdown"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Epistemic Rigor Score (e.g. 92/100)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. Click on the **Claim Verification Ledger** tab:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Filter by **\"Contradicted\"** to observe claim `CLM-004`: Notice how the false proposition regarding patent-only immediate fixes was caught and revised to reflect technical bioreactor constraints."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Click **\"Inspect\"** on any source row to review the verbatim retrieved excerpt."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. Click on the **8-Stage Pipeline Audit** tab to inspect each isolated stage\'s runtime, telemetry, and non-hallucination guardrails."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "6. Click **\"Copy Markdown\"** or **\"Print / PDF\"** to export the brief."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "7. Click **\"New Research\"** to submit a custom research topic!"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
        }
        absolute_uri: "file:///README.md"
        create_file: true
      }
    }
    use_fast_apply: true
    description: "Create comprehensive README with architecture, 8-stage prompt workflow, setup, and deployment guides"
    diff_stats {
      additions: 152
    }
  }
}
