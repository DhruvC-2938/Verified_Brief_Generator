  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { BookOpen, ShieldCheck, Activity, Sparkles, RefreshCw } from \'lucide-react\';\n\ninterface HeaderProps {\n  onSelectSample: (key: string) => void;\n  onReset: () => void;\n  currentTopic?: string;\n  hasGeminiKey?: boolean;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  onSelectSample,\n  onReset,\n  currentTopic,\n  hasGeminiKey = true,\n}) => {\n  return (\n    <header className=\"border-b border-slate-200 bg-white/95 backdrop-blur-sm sticky top-0 z-40 transition-all\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16 sm:h-20\">\n          {/* Logo & Title */}\n          <button\n            onClick={onReset}\n            className=\"flex items-center gap-3 text-left group focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 rounded-lg p-1\"\n          >\n            <div className=\"w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-slate-900 text-white flex items-center justify-center shadow-md shadow-slate-900/10 group-hover:bg-indigo-950 transition-colors\">\n              <ShieldCheck className=\"w-6 h-6 text-indigo-400 group-hover:scale-105 transition-transform\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"font-serif font-bold text-lg sm:text-xl text-slate-900 tracking-tight\">\n                  Verified Academic Brief Generator\n                </span>\n                <span className=\"hidden md:inline-flex items-center px-2 py-0.5 text-[11px] font-mono font-medium text-indigo-700 bg-indigo-50 border border-indigo-100 rounded\">\n                  v2.4 Grounded\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-500 font-sans hidden sm:block\">\n                Epistemic AI Research & Traceable Claim-Level Evidence Verification\n              </p>\n            </div>\n          </button>\n\n          {/* Quick Actions & Sample Topics */}\n          <div className=\"flex items-center gap-2 sm:gap-3\">\n            <div className=\"hidden lg:flex items-center gap-1.5 text-xs text-slate-600 border-r border-slate-200 pr-3 mr-1\">\n              <span className=\"font-medium text-slate-500\">Sample Topics:</span>\n              <button\n                onClick={() => onSelectSample(\'mrna-vaccine-distribution\')}\n                className=\"px-2.5 py-1 text-xs rounded hover:bg-slate-100 text-slate-700 font-medium transition-colors\"\n              >\n                mRNA Equity\n              </button>\n              <button\n                onClick={() => onSelectSample(\'post-quantum-cryptography\')}\n                className=\"px-2.5 py-1 text-xs rounded hover:bg-slate-100 text-slate-700 font-medium transition-colors\"\n              >\n                Post-Quantum NIST\n              </button>\n            </div>\n\n            <button\n              onClick={onReset}\n              className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors\"\n              title=\"Reset search and create new brief\"\n            >\n              <RefreshCw className=\"w-3.5 h-3.5 text-slate-500\" />\n              <span>New Research</span>\n            </button>\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/Header.tsx"
        }
        overwrite: true
      }
    }
