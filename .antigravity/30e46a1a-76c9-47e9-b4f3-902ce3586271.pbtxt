  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport {\n  CheckCircle2,\n  AlertTriangle,\n  Clock,\n  Code,\n  Layers,\n  Terminal,\n  ShieldCheck,\n  ChevronDown,\n  ChevronRight,\n} from \'lucide-react\';\nimport { StageAudit } from \'../types/index.ts\';\n\ninterface StageAuditViewProps {\n  stages: StageAudit[];\n}\n\nexport const StageAuditView: React.FC<StageAuditViewProps> = ({ stages }) => {\n  const [expandedStages, setExpandedStages] = React.useState<Record<number, boolean>>({\n    1: true,\n    2: true,\n    6: true,\n    7: true,\n  });\n\n  const toggleStage = (num: number) => {\n    setExpandedStages((prev) => ({ ...prev, [num]: !prev[num] }));\n  };\n\n  const totalDuration = stages.reduce((acc, s) => acc + s.durationMs, 0);\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Info */}\n      <div className=\"bg-white p-6 rounded-2xl border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2 text-xs font-mono font-medium text-indigo-700 uppercase tracking-wider mb-1\">\n            <span>Academic Pipeline Telemetry</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>Deterministic Prompt Engineering Separation</span>\n          </div>\n          <h3 className=\"text-xl font-serif font-bold text-slate-900\">\n            8-Stage Prompt Engineering Architecture Audit\n          </h3>\n          <p className=\"text-xs text-slate-500 font-sans mt-1 max-w-2xl\">\n            Each research stage operates in isolation to prevent hallucination: source discovery is strictly decoupled from credibility appraisal, and draft synthesis is adversarially audited by claim verification.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-3 bg-slate-50 p-3 rounded-xl border border-slate-200\">\n          <Clock className=\"w-4 h-4 text-slate-500\" />\n          <div className=\"text-right\">\n            <div className=\"text-[10px] font-mono uppercase text-slate-400\">Total Pipeline Runtime</div>\n            <div className=\"text-sm font-mono font-bold text-slate-800\">\n              {(totalDuration / 1000).toFixed(2)}s ({totalDuration}ms)\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Stages List */}\n      <div className=\"space-y-3\">\n        {stages.map((stage) => {\n          const isExpanded = expandedStages[stage.stageNumber];\n\n          return (\n            <div\n              key={stage.stageNumber}\n              className=\"bg-white rounded-2xl border border-slate-200 overflow-hidden transition-all shadow-xs\"\n            >\n              <button\n                type=\"button\"\n                onClick={() => toggleStage(stage.stageNumber)}\n                className=\"w-full p-4 sm:p-5 flex items-center justify-between text-left hover:bg-slate-50/70 transition-colors focus:outline-none\"\n              >\n                <div className=\"flex items-center gap-3 sm:gap-4\">\n                  <div\n                    className={`w-8 h-8 rounded-lg flex items-center justify-center font-mono text-xs font-bold ${\n                      stage.status === \'flagged\'\n                        ? \'bg-amber-100 text-amber-800 border border-amber-300\'\n                        : \'bg-indigo-50 text-indigo-800 border border-indigo-200\'\n                    }`}\n                  >\n                    0{stage.stageNumber}\n                  </div>\n                  <div>\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"text-sm font-semibold text-slate-900 font-serif\">\n                        {stage.name}\n                      </span>\n                      {stage.status === \'flagged\' && (\n                        <span className=\"px-2 py-0.5 text-[10px] font-mono font-medium text-amber-800 bg-amber-50 border border-amber-200 rounded\">\n                          Contradictions Audited\n                        </span>\n                      )}\n                    </div>\n                    <p className=\"text-xs text-slate-500 font-sans mt-0.5\">\n                      {stage.description}\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-4\">\n                  <span className=\"text-xs font-mono text-slate-400 hidden sm:inline\">\n                    {stage.durationMs}ms\n                  </span>\n                  {stage.status === \'flagged\' ? (\n                    <AlertTriangle className=\"w-4 h-4 text-amber-500\" />\n                  ) : (\n                    <CheckCircle2 className=\"w-4 h-4 text-emerald-600\" />\n                  )}\n                  {isExpanded ? (\n                    <ChevronDown className=\"w-4 h-4 text-slate-400\" />\n                  ) : (\n                    <ChevronRight className=\"w-4 h-4 text-slate-400\" />\n                  )}\n                </div>\n              </button>\n\n              {isExpanded && (\n                <div className=\"px-5 pb-5 pt-2 border-t border-slate-100 bg-slate-50/40 space-y-3\">\n                  <div>\n                    <span className=\"text-[10px] font-mono uppercase tracking-wider text-slate-400 font-semibold block mb-1\">\n                      Execution Summary & Epistemic Actions:\n                    </span>\n                    <p className=\"text-xs text-slate-700 font-sans leading-relaxed\">\n                      {stage.detailSummary}\n                    </p>\n                  </div>\n\n                  {stage.outputArtifacts && (\n                    <div className=\"p-3 bg-slate-900 text-slate-200 rounded-xl font-mono text-xs overflow-x-auto\">\n                      <div className=\"text-[10px] uppercase text-indigo-400 mb-1 font-bold\">\n                        Stage Output Artifacts:\n                      </div>\n                      <pre className=\"text-[11px] leading-tight\">\n                        {JSON.stringify(stage.outputArtifacts, null, 2)}\n                      </pre>\n                    </div>\n                  )}\n                </div>\n              )}\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/StageAuditView.tsx"
        }
        overwrite: true
      }
    }
