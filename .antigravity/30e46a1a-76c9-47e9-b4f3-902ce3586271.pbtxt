  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  Copy,\n  Check,\n  Download,\n  Printer,\n  ExternalLink,\n  BookOpen,\n  Calendar,\n  Award,\n  Layers,\n  ShieldCheck,\n  AlertTriangle,\n  Share2,\n} from \'lucide-react\';\nimport { AcademicBriefData, SourceItem } from \'../types/index.ts\';\n\ninterface BriefViewerProps {\n  brief: AcademicBriefData;\n  onOpenSourceModal?: (source: SourceItem) => void;\n  onSelectTab?: (tab: string) => void;\n}\n\nexport const BriefViewer: React.FC<BriefViewerProps> = ({\n  brief,\n  onOpenSourceModal,\n  onSelectTab,\n}) => {\n  const [copied, setCopied] = useState(false);\n\n  // Formatted date string\n  const formattedDate = new Date(brief.generatedAt).toLocaleDateString(\'en-US\', {\n    year: \'numeric\',\n    month: \'long\',\n    day: \'numeric\',\n  });\n\n  // Generate full markdown representation for copy/download\n  const generateMarkdown = (): string => {\n    return `# ${brief.title}\n\n**Topic:** ${brief.topic}  \n**Research Question:** ${brief.researchQuestion}  \n**Academic Level:** ${brief.academicLevel.toUpperCase()}  \n**Generated Date:** ${formattedDate}  \n**Verification Rigor Index:** ${brief.metrics.verificationRigorScore}/100  \n\n---\n\n## 1. Executive Summary\n${brief.executiveSummary}\n\n## 2. Introduction & Background\n${brief.introduction}\n\n## 3. Key Findings\n${brief.keyFindings.map((kf, i) => `${i + 1}. ${kf}`).join(\'\\n\')}\n\n## 4. Evidence-Backed Analysis\n${brief.evidenceAnalysis}\n\n## 5. Important Limitations & Conflicting Information\n${brief.limitationsAndConflictingInfo}\n\n## 6. Conclusion & Recommendations\n${brief.conclusion}\n\n---\n\n## 7. Claim-Level Verification Ledger\n| ID | Claim Statement | Sources | Status | Epistemic Rationale |\n|---|---|---|---|---|\n${brief.claims\n  .map(\n    (c) =>\n      `| ${c.id} | ${c.claimText.replace(/\\|/g, \'-\')} | ${c.sourceIds.join(\', \')} | ${c.status.toUpperCase()} | ${c.rationale.replace(/\\|/g, \'-\')} |`\n  )\n  .join(\'\\n\')}\n\n---\n\n## 8. References & Traceable Sources\n${brief.references\n  .map(\n    (ref) =>\n      `[${ref.id}] ${ref.authorsOrPublisher} (${ref.publicationDate}). *${ref.title}*. Retrieved from: ${ref.url}`\n  )\n  .join(\'\\n\\n\')}\n\n*Generated by Verified Academic Brief Generator. AI evaluations assess concordance between retrieved source excerpts and generated assertions.*\n`;\n  };\n\n  const handleCopy = async () => {\n    try {\n      await navigator.clipboard.writeText(generateMarkdown());\n      setCopied(true);\n      setTimeout(() => setCopied(false), 2500);\n    } catch (err) {\n      console.error(\'Failed to copy markdown:\', err);\n    }\n  };\n\n  const handleDownload = () => {\n    const md = generateMarkdown();\n    const blob = new Blob([md], { type: \'text/markdown;charset=utf-8;\' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = `${brief.topic.slice(0, 30).toLowerCase().replace(/[^a-z0-9]/g, \'-\')}-brief.md`;\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n    URL.revokeObjectURL(url);\n  };\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  // Helper to render text with interactive [S#] citations\n  const renderTextWithCitations = (text: string) => {\n    if (!text) return null;\n    const parts = text.split(/(\\[S\\d+(?:,\\s*S\\d+)*\\])/g);\n\n    return parts.map((part, index) => {\n      const match = part.match(/\\[(S\\d+(?:,\\s*S\\d+)*)\\]/);\n      if (match) {\n        const ids = match[1].split(\',\').map((id) => id.trim());\n        return (\n          <span key={index} className=\"inline-flex items-center gap-0.5 mx-1\">\n            {ids.map((id) => {\n              const src = brief.sources.find((s) => s.id === id);\n              return (\n                <button\n                  key={id}\n                  type=\"button\"\n                  onClick={() => src && onOpenSourceModal?.(src)}\n                  className=\"inline-flex items-center text-[11px] font-mono font-semibold text-indigo-700 hover:text-indigo-900 bg-indigo-50 hover:bg-indigo-100 px-1.5 py-0.5 rounded border border-indigo-200 transition-colors cursor-pointer\"\n                  title={src ? `${src.publisher}: ${src.title}` : `Source [${id}]`}\n                >\n                  [{id}]\n                </button>\n              );\n            })}\n          </span>\n        );\n      }\n      return <span key={index}>{part}</span>;\n    });\n  };\n\n  return (\n    <article className=\"bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden print:border-none print:shadow-none\">\n      {/* Article Control Toolbar */}\n      <div className=\"bg-slate-50 border-b border-slate-200 px-6 py-4 flex flex-wrap items-center justify-between gap-3 print:hidden\">\n        <div className=\"flex items-center gap-2 text-xs text-slate-500 font-mono\">\n          <BookOpen className=\"w-4 h-4 text-slate-400\" />\n          <span>Academic Level: <strong className=\"text-slate-800 uppercase\">{brief.academicLevel}</strong></span>\n          <span aria-hidden=\"true\">\302\267</span>\n          <span>Length: <strong className=\"text-slate-800 uppercase\">{brief.briefLength}</strong></span>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={handleCopy}\n            className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-700 bg-white hover:bg-slate-100 border border-slate-200 rounded-lg transition-colors shadow-xs\"\n            title=\"Copy formatted markdown with citations\"\n          >\n            {copied ? (\n              <>\n                <Check className=\"w-3.5 h-3.5 text-emerald-600\" />\n                <span className=\"text-emerald-700 font-semibold\">Copied!</span>\n              </>\n            ) : (\n              <>\n                <Copy className=\"w-3.5 h-3.5 text-slate-500\" />\n                <span>Copy Markdown</span>\n              </>\n            )}\n          </button>\n\n          <button\n            onClick={handleDownload}\n            className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-700 bg-white hover:bg-slate-100 border border-slate-200 rounded-lg transition-colors shadow-xs\"\n            title=\"Download brief as .md file\"\n          >\n            <Download className=\"w-3.5 h-3.5 text-slate-500\" />\n            <span>Download .md</span>\n          </button>\n\n          <button\n            onClick={handlePrint}\n            className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-700 bg-white hover:bg-slate-100 border border-slate-200 rounded-lg transition-colors shadow-xs\"\n            title=\"Print or export as PDF\"\n          >\n            <Printer className=\"w-3.5 h-3.5 text-slate-500\" />\n            <span>Print / PDF</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Main Scholarly Body */}\n      <div className=\"p-6 sm:p-10 lg:p-12 max-w-4xl mx-auto space-y-10\">\n        {/* Title Header */}\n        <header className=\"border-b border-slate-200 pb-8 space-y-4\">\n          <div className=\"flex items-center gap-2 text-xs font-mono font-medium text-indigo-700\">\n            <span>Verified Academic Brief</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>{formattedDate}</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>Rigor Score {brief.metrics.verificationRigorScore}/100</span>\n          </div>\n\n          <h1 className=\"text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-slate-900 tracking-tight leading-tight\">\n            {brief.title}\n          </h1>\n\n          <div className=\"p-4 bg-slate-50 rounded-xl border border-slate-200/80\">\n            <span className=\"text-[11px] font-mono uppercase tracking-wider text-slate-500 font-semibold block mb-1\">\n              Primary Research Question:\n            </span>\n            <p className=\"text-sm sm:text-base font-serif italic text-slate-800 leading-relaxed\">\n              \"{brief.researchQuestion}\"\n            </p>\n          </div>\n        </header>\n\n        {/* 1. Executive Summary */}\n        <section className=\"space-y-3\">\n          <h2 className=\"text-lg font-serif font-bold text-slate-900 border-b border-slate-100 pb-2 flex items-center justify-between\">\n            <span>1. Executive Summary</span>\n          </h2>\n          <div className=\"text-sm sm:text-base font-sans text-slate-700 leading-relaxed space-y-3 whitespace-pre-line\">\n            {renderTextWithCitations(brief.executiveSummary)}\n          </div>\n        </section>\n\n        {/* 2. Introduction & Background */}\n        <section className=\"space-y-3\">\n          <h2 className=\"text-lg font-serif font-bold text-slate-900 border-b border-slate-100 pb-2\">\n            2. Introduction & Foundational Background\n          </h2>\n          <div className=\"text-sm sm:text-base font-sans text-slate-700 leading-relaxed space-y-3 whitespace-pre-line\">\n            {renderTextWithCitations(brief.introduction)}\n          </div>\n        </section>\n\n        {/* 3. Key Findings */}\n        <section className=\"space-y-4\">\n          <div className=\"flex items-center justify-between border-b border-slate-100 pb-2\">\n            <h2 className=\"text-lg font-serif font-bold text-slate-900\">\n              3. Key Empirical Findings\n            </h2>\n            <button\n              onClick={() => onSelectTab?.(\'claims\')}\n              className=\"text-xs font-mono text-indigo-700 hover:underline flex items-center gap-1 print:hidden\"\n            >\n              <span>View Claim Ledger ({brief.claims.length})</span>\n            </button>\n          </div>\n\n          <div className=\"space-y-2.5\">\n            {brief.keyFindings.map((finding, idx) => (\n              <div\n                key={idx}\n                className=\"p-3.5 bg-slate-50/70 rounded-xl border border-slate-200/60 flex items-start gap-3\"\n              >\n                <span className=\"text-xs font-mono font-bold text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded border border-indigo-100 shrink-0 mt-0.5\">\n                  0{idx + 1}\n                </span>\n                <p className=\"text-sm font-sans text-slate-800 leading-relaxed\">\n                  {renderTextWithCitations(finding)}\n                </p>\n              </div>\n            ))}\n          </div>\n        </section>\n\n        {/* 4. Evidence-Backed Analysis */}\n        <section className=\"space-y-3\">\n          <h2 className=\"text-lg font-serif font-bold text-slate-900 border-b border-slate-100 pb-2\">\n            4. Evidence-Backed Analysis & Synthesis\n          </h2>\n          <div className=\"text-sm sm:text-base font-sans text-slate-700 leading-relaxed space-y-4 whitespace-pre-line\">\n            {renderTextWithCitations(brief.evidenceAnalysis)}\n          </div>\n        </section>\n\n        {/* 5. Limitations & Conflicting Information */}\n        <section className=\"space-y-3\">\n          <div className=\"flex items-center gap-2 border-b border-slate-100 pb-2\">\n            <AlertTriangle className=\"w-4 h-4 text-amber-600\" />\n            <h2 className=\"text-lg font-serif font-bold text-slate-900\">\n              5. Important Limitations & Conflicting Information\n            </h2>\n          </div>\n          <div className=\"p-4 bg-amber-50/40 border border-amber-200/70 rounded-xl text-sm font-sans text-slate-800 leading-relaxed space-y-3 whitespace-pre-line\">\n            {renderTextWithCitations(brief.limitationsAndConflictingInfo)}\n          </div>\n        </section>\n\n        {/* 6. Conclusion */}\n        <section className=\"space-y-3\">\n          <h2 className=\"text-lg font-serif font-bold text-slate-900 border-b border-slate-100 pb-2\">\n            6. Conclusion & Strategic Implications\n          </h2>\n          <div className=\"text-sm sm:text-base font-sans text-slate-700 leading-relaxed space-y-3 whitespace-pre-line\">\n            {renderTextWithCitations(brief.conclusion)}\n          </div>\n        </section>\n\n        {/* 7. References Section */}\n        <section className=\"pt-6 border-t-2 border-slate-200 space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <h2 className=\"text-lg font-serif font-bold text-slate-900\">\n              7. Traceable References & Grounded Sources\n            </h2>\n            <button\n              onClick={() => onSelectTab?.(\'sources\')}\n              className=\"text-xs font-mono text-indigo-700 hover:underline print:hidden\"\n            >\n              <span>View Source Telemetry ({brief.sources.length})</span>\n            </button>\n          </div>\n\n          <div className=\"space-y-3\">\n            {brief.references.map((ref) => (\n              <div\n                key={ref.id}\n                className=\"text-xs text-slate-700 font-sans pl-6 relative leading-relaxed\"\n              >\n                <span className=\"font-mono font-bold text-indigo-700 absolute left-0 top-0\">\n                  [{ref.id}]\n                </span>\n                <span className=\"font-medium text-slate-900\">{ref.authorsOrPublisher}. </span>\n                <span>({ref.publicationDate}). </span>\n                <span className=\"italic font-serif\">{ref.title}. </span>\n                <span className=\"text-slate-500\">{ref.sourceType}. </span>\n                <a\n                  href={ref.url}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"text-indigo-600 hover:underline inline-flex items-center gap-1 font-mono text-[11px] break-all\"\n                >\n                  <span>{ref.url}</span>\n                  <ExternalLink className=\"w-3 h-3 shrink-0 inline\" />\n                </a>\n              </div>\n            ))}\n          </div>\n        </section>\n\n        {/* Disclaimer Footer */}\n        <footer className=\"pt-6 border-t border-slate-200 text-xs text-slate-500 font-sans space-y-1\">\n          <div className=\"font-semibold text-slate-700\">Epistemic Verification Methodology Note:</div>\n          <p>\n            This brief was synthesized and verified by the Verified Academic Brief Generator. Every factual claim is programmatically checked against live search grounding excerpts. Verification designations (Supported, Partially Supported, Contradicted, Unverified) indicate textual concordance with retrieved evidence. AI verification is not an infallible guarantee of factual truth; readers should inspect the original primary sources.\n          </p>\n        </footer>\n      </div>\n    </article>\n  );\n};\n"
