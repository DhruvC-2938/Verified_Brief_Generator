  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { ExternalLink, Copy, Check, BookOpen } from \'lucide-react\';\nimport { AcademicReference } from \'../types/index.ts\';\n\ninterface ReferencesViewProps {\n  references: AcademicReference[];\n}\n\nexport const ReferencesView: React.FC<ReferencesViewProps> = ({ references }) => {\n  const [copiedId, setCopiedId] = useState<string | null>(null);\n\n  const handleCopyCitation = async (ref: AcademicReference) => {\n    try {\n      await navigator.clipboard.writeText(ref.formattedCitation);\n      setCopiedId(ref.id);\n      setTimeout(() => setCopiedId(null), 2000);\n    } catch (err) {\n      console.error(\'Failed to copy citation:\', err);\n    }\n  };\n\n  return (\n    <div className=\"bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 space-y-6\">\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-4\">\n        <div>\n          <h3 className=\"text-lg font-serif font-bold text-slate-900\">\n            Traceable References & Bibliographic Ledger ({references.length})\n          </h3>\n          <p className=\"text-xs text-slate-500 font-sans mt-0.5\">\n            Standard APA/IEEE formatted citations linked directly to live web documents and persistent identifiers.\n          </p>\n        </div>\n      </div>\n\n      <div className=\"space-y-4\">\n        {references.map((ref) => (\n          <div\n            key={ref.id}\n            className=\"p-4 rounded-xl border border-slate-100 bg-slate-50/50 hover:bg-slate-50 transition-colors flex flex-col sm:flex-row sm:items-start justify-between gap-4\"\n          >\n            <div className=\"flex items-start gap-3\">\n              <span className=\"font-mono text-xs font-bold text-indigo-700 bg-indigo-50 border border-indigo-100 px-2 py-0.5 rounded shrink-0 mt-0.5\">\n                [{ref.id}]\n              </span>\n              <div className=\"space-y-1\">\n                <p className=\"text-xs sm:text-sm font-serif text-slate-800 leading-relaxed\">\n                  {ref.formattedCitation}\n                </p>\n                <div className=\"flex flex-wrap items-center gap-2 text-[11px] text-slate-500 font-mono\">\n                  <span>Type: <strong className=\"text-slate-700\">{ref.sourceType}</strong></span>\n                  <span aria-hidden=\"true\">\302\267</span>\n                  <span>Date: <strong className=\"text-slate-700\">{ref.publicationDate}</strong></span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"flex items-center gap-2 shrink-0 self-end sm:self-start\">\n              <button\n                onClick={() => handleCopyCitation(ref)}\n                className=\"inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium text-slate-600 hover:text-slate-900 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 transition-colors shadow-2xs\"\n                title=\"Copy citation to clipboard\"\n              >\n                {copiedId === ref.id ? (\n                  <>\n                    <Check className=\"w-3 h-3 text-emerald-600\" />\n                    <span className=\"text-emerald-700 text-[11px]\">Copied</span>\n                  </>\n                ) : (\n                  <>\n                    <Copy className=\"w-3 h-3 text-slate-400\" />\n                    <span className=\"text-[11px]\">Copy</span>\n                  </>\n                )}\n              </button>\n              <a\n                href={ref.url}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium text-indigo-700 hover:text-indigo-900 bg-indigo-50 hover:bg-indigo-100 border border-indigo-100 rounded-lg transition-colors\"\n                title=\"Open persistent URL\"\n              >\n                <span className=\"text-[11px]\">Link</span>\n                <ExternalLink className=\"w-3 h-3\" />\n              </a>\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/ReferencesView.tsx"
        }
        overwrite: true
      }
    }
