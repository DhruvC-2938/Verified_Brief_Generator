  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  CheckCircle2,\n  AlertTriangle,\n  XCircle,\n  HelpCircle,\n  ExternalLink,\n  Search,\n  Filter,\n  Info,\n  Quote,\n  ShieldAlert,\n  ArrowRight,\n} from \'lucide-react\';\nimport { ClaimVerification, SourceItem, VerificationStatus } from \'../types/index.ts\';\n\ninterface ClaimsTableProps {\n  claims: ClaimVerification[];\n  sources: SourceItem[];\n  onOpenSourceModal?: (source: SourceItem) => void;\n  initialFilter?: string;\n}\n\nexport const ClaimsTable: React.FC<ClaimsTableProps> = ({\n  claims,\n  sources,\n  onOpenSourceModal,\n  initialFilter = \'all\',\n}) => {\n  const [filter, setFilter] = useState<string>(initialFilter);\n  const [searchQuery, setSearchQuery] = useState(\'\');\n\n  const filteredClaims = claims.filter((claim) => {\n    if (filter !== \'all\' && claim.status !== filter) return false;\n    if (searchQuery.trim()) {\n      const q = searchQuery.toLowerCase();\n      return (\n        claim.claimText.toLowerCase().includes(q) ||\n        claim.rationale.toLowerCase().includes(q) ||\n        claim.evidenceExcerpt.toLowerCase().includes(q) ||\n        claim.id.toLowerCase().includes(q)\n      );\n    }\n    return true;\n  });\n\n  const getSource = (sourceId: string): SourceItem | undefined => {\n    return sources.find((s) => s.id === sourceId);\n  };\n\n  const renderStatusBadge = (status: VerificationStatus, confidenceScore: number) => {\n    switch (status) {\n      case \'supported\':\n        return (\n          <div className=\"flex flex-col items-start gap-0.5\">\n            <span className=\"inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono font-semibold text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-md\">\n              <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-600\" />\n              Supported\n            </span>\n            <span className=\"text-[10px] font-mono text-slate-500 pl-1\">{confidenceScore}% confidence</span>\n          </div>\n        );\n      case \'partially_supported\':\n        return (\n          <div className=\"flex flex-col items-start gap-0.5\">\n            <span className=\"inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono font-semibold text-amber-800 bg-amber-50 border border-amber-200 rounded-md\">\n              <AlertTriangle className=\"w-3.5 h-3.5 text-amber-600\" />\n              Partially Supported\n            </span>\n            <span className=\"text-[10px] font-mono text-slate-500 pl-1\">{confidenceScore}% confidence</span>\n          </div>\n        );\n      case \'contradicted\':\n        return (\n          <div className=\"flex flex-col items-start gap-0.5\">\n            <span className=\"inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono font-semibold text-rose-800 bg-rose-50 border border-rose-200 rounded-md\">\n              <XCircle className=\"w-3.5 h-3.5 text-rose-600\" />\n              Contradicted\n            </span>\n            <span className=\"text-[10px] font-mono text-rose-600 font-semibold pl-1\">Flagged & Refuted</span>\n          </div>\n        );\n      case \'unverified\':\n      default:\n        return (\n          <div className=\"flex flex-col items-start gap-0.5\">\n            <span className=\"inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono font-semibold text-slate-800 bg-slate-100 border border-slate-300 rounded-md\">\n              <HelpCircle className=\"w-3.5 h-3.5 text-slate-500\" />\n              Unverified\n            </span>\n            <span className=\"text-[10px] font-mono text-slate-500 pl-1\">Inconclusive excerpt</span>\n          </div>\n        );\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Epistemic Transparency Notice */}\n      <div className=\"p-4 bg-indigo-50/60 border border-indigo-100 rounded-2xl flex items-start gap-3\">\n        <Info className=\"w-5 h-5 text-indigo-700 shrink-0 mt-0.5\" />\n        <div className=\"text-xs text-indigo-950 leading-relaxed font-sans\">\n          <span className=\"font-semibold\">Claim-Level Verification Methodology:</span> Each proposition is audited against verbatim excerpts retrieved from primary sources. A claim is designated <strong className=\"text-emerald-900\">Supported</strong> only when the empirical excerpt directly confirms the assertion. If an assertion overreaches or is contradicted by facts, it is marked <strong className=\"text-rose-900\">Contradicted</strong> and epistemic revisions are presented.\n        </div>\n      </div>\n\n      {/* Controls & Filter Bar */}\n      <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3\">\n        {/* Status Filter Tabs */}\n        <div className=\"flex items-center gap-1 p-1 bg-slate-100 rounded-xl overflow-x-auto text-xs\">\n          {[\n            { id: \'all\', label: \'All Claims\', count: claims.length },\n            { id: \'supported\', label: \'Supported\', count: claims.filter((c) => c.status === \'supported\').length },\n            { id: \'partially_supported\', label: \'Partial\', count: claims.filter((c) => c.status === \'partially_supported\').length },\n            { id: \'contradicted\', label: \'Contradicted\', count: claims.filter((c) => c.status === \'contradicted\').length },\n            { id: \'unverified\', label: \'Unverified\', count: claims.filter((c) => c.status === \'unverified\').length },\n          ].map((tab) => (\n            <button\n              key={tab.id}\n              onClick={() => setFilter(tab.id)}\n              className={`px-3 py-1.5 font-medium rounded-lg whitespace-nowrap transition-all ${\n                filter === tab.id\n                  ? \'bg-white text-slate-900 shadow-sm font-semibold\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              <span>{tab.label}</span>\n              <span className=\"ml-1.5 text-[11px] font-mono opacity-70\">({tab.count})</span>\n            </button>\n          ))}\n        </div>\n\n        {/* Search Input */}\n        <div className=\"relative w-full sm:w-64\">\n          <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n          <input\n            type=\"text\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            placeholder=\"Search claims & rationale...\"\n            className=\"w-full pl-9 pr-3 py-1.5 text-xs bg-white border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-900 placeholder:text-slate-400\"\n          />\n        </div>\n      </div>\n\n      {/* Claims Ledger Cards / Table */}\n      {filteredClaims.length === 0 ? (\n        <div className=\"text-center py-12 bg-white rounded-2xl border border-slate-200 p-8\">\n          <HelpCircle className=\"w-8 h-8 text-slate-300 mx-auto mb-2\" />\n          <h4 className=\"text-sm font-semibold text-slate-700\">No claims match the filter</h4>\n          <p className=\"text-xs text-slate-500 mt-1\">Try clearing search filters or choosing another status.</p>\n          <button\n            onClick={() => {\n              setFilter(\'all\');\n              setSearchQuery(\'\');\n            }}\n            className=\"mt-3 px-3 py-1.5 text-xs text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-lg font-medium transition-colors\"\n          >\n            Reset Filters\n          </button>\n        </div>\n      ) : (\n        <div className=\"space-y-4\">\n          {filteredClaims.map((claim) => (\n            <div\n              key={claim.id}\n              className={`bg-white rounded-2xl border p-5 sm:p-6 transition-all shadow-sm ${\n                claim.status === \'contradicted\'\n                  ? \'border-rose-200 bg-rose-50/15\'\n                  : claim.status === \'partially_supported\'\n                  ? \'border-amber-200 bg-amber-50/10\'\n                  : \'border-slate-200\'\n              }`}\n            >\n              {/* Claim Card Header */}\n              <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-slate-100\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"font-mono text-xs font-bold text-slate-900 px-2 py-0.5 bg-slate-100 rounded\">\n                    {claim.id}\n                  </span>\n                  <span className=\"text-xs text-slate-500 font-medium\">\n                    Section: <span className=\"text-slate-800\">{claim.sectionRef}</span>\n                  </span>\n                </div>\n                <div>{renderStatusBadge(claim.status, claim.confidenceScore)}</div>\n              </div>\n\n              {/* Main Claim Content */}\n              <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-5 mt-4\">\n                {/* Left Column: Claim Statement & Revision (7 cols) */}\n                <div className=\"lg:col-span-7 space-y-3\">\n                  <div>\n                    <span className=\"text-[11px] font-mono uppercase tracking-wider text-slate-500 font-semibold block mb-1\">\n                      Audited Proposition:\n                    </span>\n                    <p className=\"text-sm sm:text-base font-serif font-medium text-slate-900 leading-relaxed\">\n                      \"{claim.claimText}\"\n                    </p>\n                  </div>\n\n                  {/* If Contradicted or Revised: Show Epistemic Correction */}\n                  {claim.revisedText && (\n                    <div className=\"p-3 bg-rose-50/80 border border-rose-200 rounded-xl space-y-1\">\n                      <div className=\"flex items-center gap-1.5 text-xs font-mono font-semibold text-rose-800\">\n                        <ShieldAlert className=\"w-3.5 h-3.5\" />\n                        <span>Epistemic Correction / Revised Statement:</span>\n                      </div>\n                      <p className=\"text-xs text-rose-950 font-serif leading-relaxed italic\">\n                        \"{claim.revisedText}\"\n                      </p>\n                      {claim.originalClaimBeforeRevision && (\n                        <div className=\"text-[10px] text-rose-700 font-mono mt-1 pt-1 border-t border-rose-200/60\">\n                          Original unhedged assertion: \"{claim.originalClaimBeforeRevision}\"\n                        </div>\n                      )}\n                    </div>\n                  )}\n\n                  {/* Epistemic Rationale */}\n                  <div className=\"pt-1\">\n                    <span className=\"text-[11px] font-mono uppercase tracking-wider text-slate-500 font-semibold block mb-1\">\n                      Epistemic Audit Rationale:\n                    </span>\n                    <p className=\"text-xs text-slate-600 font-sans leading-relaxed\">\n                      {claim.rationale}\n                    </p>\n                  </div>\n                </div>\n\n                {/* Right Column: Supporting Source & Verbatim Excerpt (5 cols) */}\n                <div className=\"lg:col-span-5 bg-slate-50/80 rounded-xl p-4 border border-slate-200/70 space-y-3 flex flex-col justify-between\">\n                  <div>\n                    <div className=\"flex items-center justify-between mb-1.5\">\n                      <span className=\"text-[11px] font-mono uppercase tracking-wider text-slate-500 font-semibold\">\n                        Grounded Source Evidence:\n                      </span>\n                      <div className=\"flex items-center gap-1\">\n                        {claim.sourceIds.map((sid) => (\n                          <span\n                            key={sid}\n                            className=\"text-[11px] font-mono font-bold text-indigo-700 bg-indigo-50 px-1.5 py-0.5 rounded border border-indigo-100\"\n                          >\n                            [{sid}]\n                          </span>\n                        ))}\n                      </div>\n                    </div>\n\n                    {/* Excerpt Quote */}\n                    <div className=\"relative pl-3 border-l-2 border-indigo-400 my-2\">\n                      <Quote className=\"w-3.5 h-3.5 text-indigo-300 absolute -top-1 -left-1 opacity-40\" />\n                      <p className=\"text-xs font-serif text-slate-700 italic leading-relaxed\">\n                        \"{claim.evidenceExcerpt}\"\n                      </p>\n                    </div>\n                  </div>\n\n                  {/* Source Attribution & Link */}\n                  {claim.sourceIds.length > 0 && (() => {\n                    const src = getSource(claim.sourceIds[0]);\n                    if (!src) return null;\n                    return (\n                      <div className=\"pt-2 border-t border-slate-200/80 flex items-center justify-between gap-2\">\n                        <div className=\"min-w-0\">\n                          <div className=\"text-xs font-medium text-slate-900 truncate\">\n                            {src.title}\n                          </div>\n                          <div className=\"text-[11px] text-slate-500 truncate font-mono\">\n                            {src.publisher} \302\267 {src.publishedDate}\n                          </div>\n                        </div>\n\n                        <div className=\"flex items-center gap-1 shrink-0\">\n                          {onOpenSourceModal && (\n                            <button\n                              type=\"button\"\n                              onClick={() => onOpenSourceModal(src)}\n                              className=\"p-1.5 text-xs text-slate-600 hover:text-indigo-600 hover:bg-white rounded-lg transition-colors border border-transparent hover:border-slate-200\"\n                              title=\"Inspect full source telemetry\"\n                            >\n                              Inspect\n                            </button>\n                          )}\n                          <a\n                            href={src.url}\n                            target=\"_blank\"\n                            rel=\"noopener noreferrer\"\n                            className=\"p-1.5 text-slate-500 hover:text-indigo-600 hover:bg-white rounded-lg transition-colors\"\n                            title=\"Open original URL\"\n                          >\n                            <ExternalLink className=\"w-3.5 h-3.5\" />\n                          </a>\n                        </div>\n                      </div>\n                    );\n                  })()}\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/ClaimsTable.tsx"
        }
        overwrite: true
      }
    }
