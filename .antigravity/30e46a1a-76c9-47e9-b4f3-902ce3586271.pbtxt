      thinking_signature: "\022\246\t\n\243\t\001i\024}\023\272\253|\313$\003\223\r\346=\351\322\237\300\271/8\205\035\245\024_\211\240\226\213S\215\001\215y\221\347\232\276\b\347\347\252\2076i\245l\346\310\355\235dO\033\261\255B\233b\224ydQ\356\336\305\267\206\026\2620\275Q]\344%\316\340kp\276\316\225\240\035\343\306\204\376q\004\270\t\033\335G\211\315\201\363\177\033\203\221\032\001\031\317D\323\367X\232\036_\372\vO\234\235m\034\024\002\374\313\221\253\274V\212%\023^Z\233?sq\034\000%][\250\322\306\366\30797X\341\"p\n\220;-y\020\037\364\215\312;\2441\336W\361l\006\30595\360\256Z_G\020\374\202f\336\223\204\344\323j\2027\016s\211 \244\221O\222\377y\354\323\356\275s\351\263Lt\\b\302\314_z\250e\241\323k\222\302\264qz\276\217\341\304D\327\002\366:\221ar\366\023\\D\233\212\375\356\035`!\345j\217\241\316\332>8\332\250\000wL\251E#\362\344\213\016\363\033\005\001)\242\311K\232\273\352:J\036\277\024O\320RVU~\252L\216\220\335P~V\360\320Y\354\\\203\261\315\266\377\237j\255\006}\247\032F\370o(\335\226e\342\016A\336\345\0226j\320\373\331\037x\251\214L\207^{\312f\227~p\311J\037N\3561Q\370\343\216\377y\207\272\236\231j\023R\307BY\216]H\020\017\026\365\364\215aAO\217\211\243\023fc\214\373\244[\344}\260\220\002h\275\234\'\253D\362\320\323\303\223%_=\330\277\217k\372\322Ez\276\315{\3210\016qn\373\246\201=\234h\356\377:\f\314\270\003F\375\217\242\2455@UX:\304\227N\320\363\022\212R\250\303\342\353\217\270\360(\335\212AWJ\333\333hx\273\370\237\"V\375\214L&\017-\016B\3321\224j\330\212gI\231\371Z\234y\034<\360\341\201\2244D\350\374(\334\033f\360\036w\336\246\377\215~WE\343\263\375r%\0266\224%\237\033;A\306\b[\r\220I\214\022*7\2569\260\344t\377\024V\020#OA\0066;o\235<&\336|@T\324\252\305#.\032\325^,\0370w#\356\321,\204\037\272\360\350b\022|+\264\b\2257\201+\177\323F\223W,_\343=\312\274E3\264\001\347r\232J\177\240\aT:/}\365fg\000P\375\312\354\371\336\237\223\217)U\25479\334\034Uj\203\201\367\350u\035o\330U\316\020\225P\371|J\005\2515`)\335\0344\255\364(Mdk\026\361\354\204\374%\350\033\367e9