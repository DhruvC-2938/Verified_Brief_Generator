  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { X, ExternalLink, ShieldCheck, Calendar, Building, Globe, Quote, CheckCircle2 } from \'lucide-react\';\nimport { SourceItem, ClaimVerification } from \'../types/index.ts\';\n\ninterface SourceDetailModalProps {\n  source: SourceItem | null;\n  onClose: () => void;\n  claims?: ClaimVerification[];\n}\n\nexport const SourceDetailModal: React.FC<SourceDetailModalProps> = ({\n  source,\n  onClose,\n  claims = [],\n}) => {\n  if (!source) return null;\n\n  const associatedClaims = claims.filter((c) => c.sourceIds.includes(source.id));\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/60 backdrop-blur-xs animate-in fade-in duration-150\">\n      <div\n        className=\"bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        {/* Modal Header */}\n        <div className=\"p-6 border-b border-slate-100 flex items-start justify-between gap-4 sticky top-0 bg-white z-10\">\n          <div className=\"space-y-1\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"font-mono text-xs font-bold text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded border border-indigo-100\">\n                [{source.id}]\n              </span>\n              <span className=\"text-xs font-medium text-slate-500\">{source.sourceType}</span>\n              <span aria-hidden=\"true\" className=\"text-slate-300\">\302\267</span>\n              <div className=\"flex items-center gap-1 text-xs font-mono text-emerald-700\">\n                <ShieldCheck className=\"w-3.5 h-3.5\" />\n                <span>Authority: {source.credibilityScore}/100</span>\n              </div>\n            </div>\n            <h3 className=\"text-lg font-serif font-bold text-slate-900 leading-snug\">\n              {source.title}\n            </h3>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Modal Body */}\n        <div className=\"p-6 space-y-6\">\n          {/* Metadata Grid */}\n          <div className=\"grid grid-cols-2 gap-3 p-3.5 bg-slate-50 rounded-xl text-xs font-sans\">\n            <div>\n              <span className=\"text-[10px] font-mono uppercase text-slate-400 block\">Publisher / Institution</span>\n              <span className=\"font-medium text-slate-800\">{source.publisher}</span>\n            </div>\n            <div>\n              <span className=\"text-[10px] font-mono uppercase text-slate-400 block\">Publication Date</span>\n              <span className=\"font-medium text-slate-800\">{source.publishedDate}</span>\n            </div>\n            <div>\n              <span className=\"text-[10px] font-mono uppercase text-slate-400 block\">Domain</span>\n              <span className=\"font-mono text-slate-700\">{source.domain}</span>\n            </div>\n            <div>\n              <span className=\"text-[10px] font-mono uppercase text-slate-400 block\">Credibility Tier</span>\n              <span className=\"font-semibold text-indigo-950\">{source.credibilityTier}</span>\n            </div>\n          </div>\n\n          {/* Verbatim Excerpt */}\n          <div className=\"space-y-2\">\n            <span className=\"text-xs font-mono font-semibold uppercase tracking-wider text-slate-500\">\n              Retrieved Evidence Excerpt\n            </span>\n            <div className=\"p-4 bg-indigo-50/40 border border-indigo-100 rounded-xl relative\">\n              <Quote className=\"w-4 h-4 text-indigo-300 absolute top-3 left-3 opacity-50\" />\n              <p className=\"text-xs sm:text-sm font-serif italic text-slate-800 pl-4 leading-relaxed\">\n                \"{source.excerpt}\"\n              </p>\n            </div>\n          </div>\n\n          {/* Authority Appraisal */}\n          <div className=\"space-y-1\">\n            <span className=\"text-xs font-mono font-semibold uppercase tracking-wider text-slate-500\">\n              Authority Appraisal\n            </span>\n            <p className=\"text-xs text-slate-600 font-sans leading-relaxed\">\n              {source.credibilityNotes}\n            </p>\n          </div>\n\n          {/* Associated Claims */}\n          {associatedClaims.length > 0 && (\n            <div className=\"space-y-2\">\n              <span className=\"text-xs font-mono font-semibold uppercase tracking-wider text-slate-500\">\n                Audited Claims Linked to this Source ({associatedClaims.length})\n              </span>\n              <div className=\"space-y-2\">\n                {associatedClaims.map((claim) => (\n                  <div\n                    key={claim.id}\n                    className=\"p-3 bg-slate-50 rounded-xl border border-slate-200/80 text-xs flex items-start justify-between gap-2\"\n                  >\n                    <div>\n                      <span className=\"font-mono font-bold text-slate-900 mr-2\">[{claim.id}]</span>\n                      <span className=\"font-serif text-slate-800 font-medium\">\"{claim.claimText}\"</span>\n                    </div>\n                    <span\n                      className={`text-[10px] font-mono font-semibold px-2 py-0.5 rounded capitalize shrink-0 ${\n                        claim.status === \'supported\'\n                          ? \'bg-emerald-100 text-emerald-800\'\n                          : claim.status === \'partially_supported\'\n                          ? \'bg-amber-100 text-amber-800\'\n                          : claim.status === \'contradicted\'\n                          ? \'bg-rose-100 text-rose-800\'\n                          : \'bg-slate-100 text-slate-800\'\n                      }`}\n                    >\n                      {claim.status.replace(\'_\', \' \')}\n                    </span>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"p-4 sm:p-6 border-t border-slate-100 bg-slate-50/70 rounded-b-2xl flex items-center justify-between gap-3\">\n          <span className=\"text-[11px] font-mono text-slate-400 truncate max-w-xs\">\n            {source.url}\n          </span>\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={onClose}\n              className=\"px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-200 rounded-xl transition-colors\"\n            >\n              Close\n            </button>\n            <a\n              href={source.url}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-white bg-slate-900 hover:bg-indigo-950 rounded-xl transition-colors shadow-xs\"\n            >\n              <span>Visit Source URL</span>\n              <ExternalLink className=\"w-3.5 h-3.5\" />\n            </a>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/SourceDetailModal.tsx"
        }
        overwrite: true
      }
    }
