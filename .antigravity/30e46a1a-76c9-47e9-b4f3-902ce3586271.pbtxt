      id: "call_91941"
      name: "write_to_file"
      arguments_json: "{\"Append\":false, \"CodeContent\":\"import React, { useState, useEffect } from \'react\';\\nimport { Header } from \'./components/Header.tsx\';\\nimport { ResearchForm } from \'./components/ResearchForm.tsx\';\\nimport { StageProgressTracker } from \'./components/StageProgressTracker.tsx\';\\nimport { MetricsBar } from \'./components/MetricsBar.tsx\';\\nimport { BriefViewer } from \'./components/BriefViewer.tsx\';\\nimport { ClaimsTable } from \'./components/ClaimsTable.tsx\';\\nimport { SourcesList } from \'./components/SourcesList.tsx\';\\nimport { StageAuditView } from \'./components/StageAuditView.tsx\';\\nimport { ReferencesView } from \'./components/ReferencesView.tsx\';\\nimport { SourceDetailModal } from \'./components/SourceDetailModal.tsx\';\\nimport {\\n  AcademicBriefData,\\n  BriefGenerationRequest,\\n  SourceItem,\\n  StageAudit,\\n  StageProgressUpdate,\\n} from \'./types/index.ts\';\\nimport {\\n  BookOpen,\\n  FileCheck2,\\n  Globe,\\n  Layers,\\n  FileText,\\n  AlertCircle,\\n  RefreshCw,\\n  Search,\\n  ChevronRight,\\n  ShieldCheck,\\n} from \'lucide-react\';\\n\\nexport default function App() {\\n  const [brief, setBrief] = useState<AcademicBriefData | null>(null);\\n  const [isLoading, setIsLoading] = useState(false);\\n  const [currentStage, setCurrentStage] = useState(1);\\n  const [stageMessage, setStageMessage] = useState(\'\');\\n  const [error, setError] = useState<string | null>(null);\\n  const [activeTab, setActiveTab] = useState<\'brief\' | \'claims\' | \'sources\' | \'stages\' | \'references\'>(\'brief\');\\n  const [selectedSourceModal, setSelectedSourceModal] = useState<SourceItem | null>(null);\\n  const [activeStatusFilter, setActiveStatusFilter] = useState<string>(\'all\');\\n  const [hasGeminiKey, setHasGeminiKey] = useState(true);\\n  const [showQueryForm, setShowQueryForm] = useState(true);\\n\\n  // Check health on mount\\n  useEffect(() => {\\n    fetch(\'/api/health\')\\n      .then((res) => res.json())\\n      .then((data) => {\\n        setHasGeminiKey(Boolean(data.hasGeminiKey));\\n      })\\n      .catch((err) => {\\n        console.warn(\'Health check issue:\', err);\\n      });\\n  }, []);\\n\\n  const handleSelectSample = async (key: string) => {\\n    setIsLoading(true);\\n    setError(null);\\n    setCurrentStage(1);\\n    setStageMessage(`Loading verified sample brief: ${key}...`);\\n\\n    try {\\n      const res = await fetch(`/api/samples/${key}`);\\n      if (!res.ok) {\\n        throw new Error(`Failed to load sample brief (${res.status})`);\\n      }\\n      const data = await res.json();\\n      setBrief(data);\\n      setShowQueryForm(false);\\n      setActiveTab(\'brief\');\\n    } catch (err: any) {\\n      console.error(err);\\n      setError(err.message || \'Failed to load sample brief.\');\\n    } finally {\\n      setIsLoading(false);\\n    }\\n  };\\n\\n  const handleGenerate = async (params: BriefGenerationRequest) => {\\n    setIsLoading(true);\\n    setError(null);\\n    setCurrentStage(1);\\n    setStageMessage(\'Initiating 8-stage verification pipeline...\');\\n    setShowQueryForm(false);\\n\\n    try {\\n      // Build SSE Query String\\n      const queryParams = new URLSearchParams({\\n        topic: params.topic,\\n        academicLevel: params.academicLevel,\\n        briefLength: params.briefLength,\\n        preferredSourceTypes: params.preferredSourceTypes,\\n      });\\n      if (params.researchQuestion) {\\n        queryParams.set(\'researchQuestion\', params.researchQuestion);\\n      }\\n\\n      // Try SSE Streaming endpoint first\\n      const eventSource = new EventSource(`/api/stream?${queryParams.toString()}`);\\n\\n      eventSource.addEventListener(\'stage_progress\', (e) => {\\n        try {\\n          const update: StageProgressUpdate = JSON.parse(e.data);\\n          setCurrentStage(update.stage);\\n          setStageMessage(update.message);\\n        } catch (parseErr) {\\n          console.error(\'Error parsing SSE stage progress:\', parseErr);\\n        }\\n      });\\n\\n      eventSource.addEventListener(\'complete\', (e) => {\\n        try {\\n          const completedBrief: AcademicBriefData = JSON.parse(e.data);\\n          setBrief(completedBrief);\\n          setActiveTab(\'brief\');\\n          setIsLoading(false);\\n          eventSource.close();\\n        } catch (parseErr) {\\n          console.error(\'Error parsing SSE complete:\', parseErr);\\n          setIsLoading(false);\\n          eventSource.close();\\n        }\\n      });\\n\\n      eventSource.addEventListener(\'error\', async (e) => {\\n        console.warn(\'SSE encountered error, falling back to standard POST /api/generate\');\\n        eventSource.close();\\n\\n        // Fallback to POST /api/generate\\n        try {\\n          const postRes = await fetch(\'/api/generate\', {\\n            method: \'POST\',\\n            headers: { \'Content-Type\': \'application/json\' },\\n            body: JSON.stringify(params),\\n          });\\n\\n          if (!postRes.ok) {\\n            const errData = await postRes.json().catch(() => ({}));\\n            throw new Error(errData.error || `Server error (${postRes.status})`);\\n          }\\n\\n          const fallbackBrief: AcademicBriefData = await postRes.json();\\n          setBrief(fallbackBrief);\\n          setActiveTab(\'brief\');\\n        } catch (fallbackErr: any) {\\n          setError(fallbackErr.message || \'Failed to synthesize academic brief.\');\\n          setShowQueryForm(true);\\n        } finally {\\n          setIsLoading(false);\\n        }\\n      });\\n    } catch (err: any) {\\n      console.error(err);\\n      setError(err.message || \'An unexpected error occurred.\');\\n      setIsLoading(false);\\n      setShowQueryForm(true);\\n    }\\n  };\\n\\n  const handleReset = () => {\\n    setBrief(null);\\n    setError(null);\\n    setShowQueryForm(true);\\n    setActiveTab(\'brief\');\\n    setActiveStatusFilter(\'all\');\\n  };\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-slate-50 text-slate-900 font-sans flex flex-col selection:bg-indigo-100 selection:text-indigo-900\\\">\\n      {/* Header */}\\n      <Header\\n        onSelectSample={handleSelectSample}\\n        onReset={handleReset}\\n        currentTopic={brief?.topic}\\n        hasGeminiKey={hasGeminiKey}\\n      />\\n\\n      {/* Main Container */}\\n      <main className=\\\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8\\\">\\n        {/* Error Notification */}\\n        {error && (\\n          <div className=\\\"p-4 bg-rose-50 border border-rose-200 rounded-2xl flex items-start justify-between gap-3 text-rose-900\\\">\\n            <div className=\\\"flex items-start gap-3\\\">\\n              <AlertCircle className=\\\"w-5 h-5 text-rose-600 shrink-0 mt-0.5\\\" />\\n              <div>\\n                <h4 className=\\\"text-sm font-semibold\\\">Verification Pipeline Error</h4>\\n                <p className=\\\"text-xs text-rose-800 mt-0.5\\\">{error}</p>\\n              </div>\\n            </div>\\n            <button\\n              onClick={() => setError(null)}\\n              className=\\\"text-xs font-medium text-rose-700 hover:text-rose-950 px-2 py-1 rounded-lg hover:bg-rose-100\\\"\\n            >\\n              Dismiss\\n            </button>\\n          </div>\\n        )}\\n\\n        {/* Input Form Section (Visible when no brief or user toggles showQueryForm) */}\\n        {(showQueryForm || !brief) && (\\n          <section className=\\\"transition-all\\\">\\n            <ResearchForm\\n              onSubmit={handleGenerate}\\n              isLoading={isLoading}\\n              onSelectSample={handleSelectSample}\\n            />\\n          </section>\\n        )}\\n\\n        {/* Live Stage Progress Indicator (Visible when loading) */}\\n        {isLoading && (\\n          <section className=\\\"animate-in fade-in duration-200\\\">\\n            <StageProgressTracker\\n              currentStage={currentStage}\\n              totalStages={8}\\n              stageMessage={stageMessage}\\n              isStreaming={true}\\n            />\\n          </section>\\n        )}\\n\\n        {/* Results Dashboard (Visible when brief is available) */}\\n        {brief && !isLoading && (\\n          <section className=\\\"space-y-6 animate-in fade-in duration-300\\\">\\n            {/* Top Toolbar: Topic Summary & Modify Button */}\\n            {!showQueryForm && (\\n              <div className=\\\"bg-white p-4 rounded-2xl border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs\\\">\\n                <div className=\\\"flex items-center gap-3\\\">\\n                  <div className=\\\"w-9 h-9 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center shrink-0\\\">\\n                    <BookOpen className=\\\"w-5 h-5 text-indigo-700\\\" />\\n                  </div>\\n                  <div>\\n                    <div className=\\\"text-[11px] font-mono uppercase tracking-wider text-indigo-600 font-semibold\\\">\\n                      Active Research Dossier\\n                    </div>\\n                    <div className=\\\"text-sm font-serif font-bold text-slate-900 line-clamp-1\\\">\\n                      {brief.topic}\\n                    </div>\\n                  </div>\\n                </div>\\n\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <button\\n                    onClick={() => setShowQueryForm(true)}\\n                    className=\\\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-700 hover:text-indigo-900 bg-slate-100 hover:bg-indigo-50 rounded-xl transition-colors\\\"\\n                  >\\n                    <Search className=\\\"w-3.5 h-3.5 text-slate-500\\\" />\\n                    <span>Modify Research Parameters</span>\\n                  </button>\\n                </div>\\n              </div>\\n            )}\\n\\n            {/* Metrics Bar with interactive filter triggers */}\\n            <MetricsBar\\n              metrics={brief.metrics}\\n              onFilterStatus={(status) => {\\n                setActiveStatusFilter(status);\\n                setActiveTab(\'claims\');\\n              }}\\n              activeStatusFilter={activeStatusFilter}\\n            />\\n\\n            {/* Tab Navigation */}\\n            <div className=\\\"border-b border-slate-200 bg-white rounded-t-2xl px-4 sm:px-6 pt-3\\\">\\n              <nav className=\\\"flex space-x-2 sm:space-x-4 overflow-x-auto\\\" aria-label=\\\"Tabs\\\">\\n                <button\\n                  onClick={() => setActiveTab(\'brief\')}\\n                  className={`py-3 px-3 text-xs sm:text-sm font-medium border-b-2 flex items-center gap-2 transition-all whitespace-nowrap ${\\n                    activeTab === \'brief\'\\n                      ? \'border-indigo-600 text-indigo-950 font-semibold\'\\n                      : \'border-transparent text-slate-500 hover:text-slate-800 hover:border-slate-300\'\\n                  }`}\\n                >\\n                  <BookOpen className=\\\"w-4 h-4\\\" />\\n                  <span>Academic Brief</span>\\n                </button>\\n\\n                <button\\n                  onClick={() => setActiveTab(\'claims\')}\\n                  className={`py-3 px-3 text-xs sm:text-sm font-medium border-b-2 flex items-center gap-2 transition-all whitespace-nowrap ${\\n                    activeTab === \'claims\'\\n                      ? \'border-indigo-600 text-indigo-950 font-semibold\'\\n                      : \'border-transparent text-slate-500 hover:text-slate-800 hover:border-slate-300\'\\n                  }`}\\n                >\\n                  <FileCheck2 className=\\\"w-4 h-4\\\" />\\n                  <span>Claim Verification Ledger</span>\\n                  <span className=\\\"font-mono text-xs px-2 py-0.5 rounded-full bg-slate-100 text-slate-700\\\">\\n                    {brief.claims.length}\\n                  </span>\\n                </button>\\n\\n                <button\\n                  onClick={() => setActiveTab(\'sources\')}\\n                  className={`py-3 px-3 text-xs sm:text-sm font-medium border-b-2 flex items-center gap-2 transition-all whitespace-nowrap ${\\n                    activeTab === \'sources\'\\n                      ? \'border-indigo-600 text-indigo-950 font-semibold\'\\n                      : \'border-transparent text-slate-500 hover:text-slate-800 hover:border-slate-300\'\\n                  }`}\\n                >\\n                  <Globe className=\\\"w-4 h-4\\\" />\\n                  <span>Discovered Sources</span>\\n                  <span className=\\\"font-mono text-xs px-2 py-0.5 rounded-full bg-slate-100 text-slate-700\\\">\\n                    {brief.sources.length}\\n                  </span>\\n                </button>\\n\\n                <button\\n                  onClick={() => setActiveTab(\'stages\')}\\n                  className={`py-3 px-3 text-xs sm:text-sm font-medium border-b-2 flex items-center gap-2 transition-all whitespace-nowrap ${\\n                    activeTab === \'stages\'\\n                      ? \'border-indigo-600 text-indigo-950 font-semibold\'\\n                      : \'border-transparent text-slate-500 hover:text-slate-800 hover:border-slate-300\'\\n                  }`}\\n                >\\n                  <Layers className=\\\"w-4 h-4\\\" />\\n                  <span>8-Stage Pipeline Audit</span>\\n                  <span className=\\\"font-mono text-xs px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700\\\">\\n                    8/8\\n                  </span>\\n                </button>\\n\\n                <button\\n                  onClick={() => setActiveTab(\'references\')}\\n                  className={`py-3 px-3 text-xs sm:text-sm font-medium border-b-2 flex items-center gap-2 transition-all whitespace-nowrap ${\\n                    activeTab === \'references\'\\n                      ? \'border-indigo-600 text-indigo-950 font-semibold\'\\n                      : \'border-transparent text-slate-500 hover:text-slate-800 hover:border-slate-300\'\\n                  }`}\\n                >\\n                  <FileText className=\\\"w-4 h-4\\\" />\\n                  <span>References</span>\\n                  <span className=\\\"font-mono text-xs px-2 py-0.5 rounded-full bg-slate-100 text-slate-700\\\">\\n                    {brief.references.length}\\n                  </span>\\n                </button>\\n              </nav>\\n            </div>\\n\\n            {/* Tab Panels */}\\n            <div className=\\\"transition-all\\\">\\n              {activeTab === \'brief\' && (\\n                <BriefViewer\\n                  brief={brief}\\n                  onOpenSourceModal={(src) => setSelectedSourceModal(src)}\\n                  onSelectTab={(tab) => setActiveTab(tab as any)}\\n                />\\n              )}\\n\\n              {activeTab === \'claims\' && (\\n                <ClaimsTable\\n                  claims={brief.claims}\\n                  sources={brief.sources}\\n                  onOpenSourceModal={(src) => setSelectedSourceModal(src)}\\n                  initialFilter={activeStatusFilter}\\n                />\\n              )}\\n\\n              {activeTab === \'sources\' && (\\n                <SourcesList\\n                  sources={brief.sources}\\n                  onOpenSourceModal={(src) => setSelectedSourceModal(src)}\\n                />\\n              )}\\n\\n              {activeTab === \'stages\' && (\\n                <StageAuditView stages={brief.stages} />\\n              )}\\n\\n              {activeTab === \'references\' && (\\n                <ReferencesView references={brief.references} />\\n              )}\\n            </div>\\n          </section>\\n        )}\\n      </main>\\n\\n      {/* Source Detail Modal */}\\n      <SourceDetailModal\\n        source={selectedSourceModal}\\n        onClose={() => setSelectedSourceModal(null)}\\n        claims={brief?.claims}\\n      />\\n\\n      {/* Academic Footer */}\\n      <footer className=\\\"border-t border-slate-200 bg-white py-8 mt-12 print:hidden\\\">\\n        <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 font-sans\\\">\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <ShieldCheck className=\\\"w-4 h-4 text-indigo-700\\\" />\\n            <span className=\\\"font-medium text-slate-700\\\">Verified Academic Brief Generator</span>\\n            <span aria-hidden=\\\"true\\\">\302\267</span>\\n            <span>College AI Tools & Prompt Engineering Project</span>\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-3 font-mono text-[11px] text-slate-400\\\">\\n            <span>Powered by Gemini 3.8 Flash Grounding</span>\\n            <span aria-hidden=\\\"true\\\">\302\267</span>\\n            <span>Deterministic 8-Stage Architecture</span>\\n          </div>\\n        </div>\\n      </footer>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create App.tsx coordinating the 8-stage research pipeline, SSE streaming, tabbed views, and claim verification\", \"Overwrite\":true, \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Creating App.tsx\", \"toolSummary\":\"Create App.tsx component\"}"
      thinking_signature: "\022\334\017\n\331\017\001i\024}\023D\017/\332\260\231\262\255l\221a\334qH\b\364au\232fS\026\264\203\374\2216\363\247At\205\030\032\267v\365\252\344=\004\001\177\340\247r+\257\313s\233<\266\002\'\272\az\021|\335a\221\335\344\367\227Oq\223\226\nI\337\026\333\201\244\357\212G\023\216{k\351\376)5D\215B1\t.A\345m2\257\251\256\325T\021\203Vt^\330\351\316\244~z\3526\370\214\240\317\320\224\242\230\225[\004\303f\033\342\264*4\251V\301/\234\265\333We\331Y\362\351\264I\305\223\323\350d\251\214\341\204\251\221\177\250\2005L\034Di\224\254a\315\227X8,\306.\324G\254\0379\274\310)\315\264\'\246|\356\3211>\215B-z!o\341y4\265\240\307Yv\332\362\2536\n\\Lw\306o\327\220\242\225!\376<\000\277\253b^F\273\246\036SNH\257O\030F\021y\207\305\275\252H\301\221\354\302\270\301\025\202\376UB\305\250\023P\000W\324K\024\376\006uT\321y\t\022\367\275\257\233|\373\360r\333\205\315eOj}\312\324\251\'\025\314-S\205\034\336\376\267\222\263\337\302?\230\275q\233\374V\247(\324\0312\2342/\031v\002~\001\v\262\004\v\233\376\3519\203\017\312e\233\304D\250\033\025iTDyJPN\337\337\335\b\215\367\036\356\326\271\024\000\224*\237\342wV\333\213#\023\206?\254\202~Z\267\264\024\216N\236:\352\327\260\321\240\374\255\024\363z\215\210)\370\217]\nk_I*H\215\214\266\031(\256\223\243\000\260\031\367*6r#\3457a\363\353\277\360T\217\273J\262\360\031\225\367~7\360\241\264m\2469Q\225*\031%\233\226\260\220\251\213k\212\n\037\367\314\341n(\221\210|\213iP)BX\022\035\325\002^E\024.\270\330\212\260Z7\252\205\273\025)\256 \035Cy\366\257\315\232&\371\206\353\002R_\034r\325y\215\302\316\200c\327\020\232\2049\220\376\344\250\025\025\260\200\211\024\v\260\375>\351qb\370\311PF\372|t>\205\020h3l>/\372\f\024\227\361\f\204\255\b5\340\364\265\020\225\304Vb\263,\270A_\000+jw\312\333\343\275d\374\034o\330\226\205\252\313\325\341\307=\335\252\0242\350\030\302\226H\242\351>\r\376\301\220`,q\000\n*h\225\374\233\2239\'v\001\336-\256AJ\037>\245\224\037\241\306~\362\252\310$\354\3012\233\316G{\216\270yvz\251\303\344\270\306f\