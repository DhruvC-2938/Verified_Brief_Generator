      arguments_json: "{\"Append\":false, \"CodeContent\":\"import express, { Request, Response } from \'express\';\\nimport dotenv from \'dotenv\';\\nimport path from \'path\';\\nimport { fileURLToPath } from \'url\';\\nimport { executeAcademicWorkflow } from \'./server/geminiWorkflow.ts\';\\nimport { SAMPLE_BRIEFS } from \'./server/sampleData.ts\';\\nimport { BriefGenerationRequest } from \'./src/types/index.ts\';\\n\\ndotenv.config();\\n\\nconst __filename = fileURLToPath(import.meta.url);\\nconst __dirname = path.dirname(__filename);\\n\\nconst app = express();\\nconst PORT = process.env.PORT ? parseInt(process.env.PORT, 10) : 3000;\\n\\napp.use(express.json({ limit: \'2mb\' }));\\n\\n// Health check endpoint\\napp.get(\'/api/health\', (req: Request, res: Response) => {\\n  res.json({\\n    status: \'ok\',\\n    hasGeminiKey: Boolean(process.env.GEMINI_API_KEY),\\n    model: \'gemini-3.8-flash\',\\n    timestamp: new Date().toISOString(),\\n  });\\n});\\n\\n// List available sample briefs\\napp.get(\'/api/samples\', (req: Request, res: Response) => {\\n  const summaries = Object.entries(SAMPLE_BRIEFS).map(([key, brief]) => ({\\n    key,\\n    id: brief.id,\\n    title: brief.title,\\n    topic: brief.topic,\\n    academicLevel: brief.academicLevel,\\n    sourcesCount: brief.sources.length,\\n    claimsCount: brief.claims.length,\\n    supportedCount: brief.metrics.supportedCount,\\n    contradictedCount: brief.metrics.contradictedCount,\\n  }));\\n  res.json(summaries);\\n});\\n\\n// Get specific sample brief\\napp.get(\'/api/samples/:key\', (req: Request, res: Response) => {\\n  const { key } = req.params;\\n  const sample = SAMPLE_BRIEFS[key];\\n  if (!sample) {\\n    res.status(404).json({ error: `Sample brief \\\"${key}\\\" not found.` });\\n    return;\\n  }\\n  res.json(sample);\\n});\\n\\n// Standard REST Generation Endpoint\\napp.post(\'/api/generate\', async (req: Request, res: Response) => {\\n  try {\\n    const { topic, researchQuestion, academicLevel, briefLength, preferredSourceTypes } = req.body;\\n\\n    if (!topic || typeof topic !== \'string\' || topic.trim().length < 3) {\\n      res.status(400).json({ error: \'A valid research topic of at least 3 characters is required.\' });\\n      return;\\n    }\\n\\n    const payload: BriefGenerationRequest = {\\n      topic: topic.trim(),\\n      researchQuestion: researchQuestion ? String(researchQuestion).trim() : undefined,\\n      academicLevel: academicLevel || \'undergraduate\',\\n      briefLength: briefLength || \'medium\',\\n      preferredSourceTypes: preferredSourceTypes || \'all\',\\n    };\\n\\n    const brief = await executeAcademicWorkflow(payload);\\n    res.json(brief);\\n  } catch (error: any) {\\n    console.error(\'Error generating academic brief:\', error);\\n    res.status(500).json({\\n      error: error.message || \'An error occurred during academic brief generation.\',\\n      details: error.stack,\\n    });\\n  }\\n});\\n\\n// Server-Sent Events (SSE) Live Streaming Workflow\\napp.get(\'/api/stream\', async (req: Request, res: Response) => {\\n  const topic = req.query.topic as string;\\n  const researchQuestion = req.query.researchQuestion as string | undefined;\\n  const academicLevel = (req.query.academicLevel as any) || \'undergraduate\';\\n  const briefLength = (req.query.briefLength as any) || \'medium\';\\n  const preferredSourceTypes = (req.query.preferredSourceTypes as any) || \'all\';\\n\\n  if (!topic || topic.trim().length < 3) {\\n    res.status(400).json({ error: \'A valid research topic is required.\' });\\n    return;\\n  }\\n\\n  // Set SSE Headers\\n  res.setHeader(\'Content-Type\', \'text/event-stream\');\\n  res.setHeader(\'Cache-Control\', \'no-cache\');\\n  res.setHeader(\'Connection\', \'keep-alive\');\\n  res.flushHeaders?.();\\n\\n  const sendEvent = (event: string, data: any) => {\\n    res.write(`event: ${event}\\\\ndata: ${JSON.stringify(data)}\\\\n\\\\n`);\\n  };\\n\\n  try {\\n    const payload: BriefGenerationRequest = {\\n      topic: topic.trim(),\\n      researchQuestion: researchQuestion?.trim(),\\n      academicLevel,\\n      briefLength,\\n      preferredSourceTypes,\\n    };\\n\\n    sendEvent(\'status\', { message: \'Initiating 8-stage verification pipeline...\' });\\n\\n    const brief = await executeAcademicWorkflow(payload, (update) => {\\n      sendEvent(\'stage_progress\', update);\\n    });\\n\\n    sendEvent(\'complete\', brief);\\n    res.end();\\n  } catch (error: any) {\\n    console.error(\'Streaming workflow error:\', error);\\n    sendEvent(\'error\', {\\n      message: error.message || \'Failed to complete academic brief synthesis.\',\\n    });\\n    res.end();\\n  }\\n});\\n\\nasync function startServer() {\\n  const isDev = process.env.NODE_ENV !== \'production\';\\n\\n  if (isDev) {\\n    const { createServer: createViteServer } = await import(\'vite\');\\n    const vite = await createViteServer({\\n      server: { middlewareMode: true },\\n      appType: \'spa\',\\n    });\\n    app.use(vite.middlewares);\\n  } else {\\n    // Production static serving\\n    const distPath = path.resolve(__dirname, \'dist\');\\n    app.use(express.static(distPath));\\n    app.get(\'*\', (req: Request, res: Response) => {\\n      res.sendFile(path.resolve(distPath, \'index.html\'));\\n    });\\n  }\\n\\n  app.listen(PORT, \'0.0.0.0\', () => {\\n    console.log(`Academic Brief Generator Server running on http://0.0.0.0:${PORT}`);\\n  });\\n}\\n\\nstartServer().catch((err) => {\\n  console.error(\'Failed to start server:\', err);\\n});\\n\", \"Description\":\"Create express server entry point with REST, SSE streaming, sample data endpoints, and Vite integration\", \"Overwrite\":true, \"TargetFile\":\"/server.ts\", \"toolAction\":\"Creating server.ts\", \"toolSummary\":\"Create full-stack server.ts\"}"
      thinking_signature: "\022\202\n\n\377\t\001i\024}\023\367e\177\323\360\347\340\232\0343\346|\221z\265f\277\363\307\021\020t\357\243\214P\355z\370n!AU\207 \315\023EZ\334\274\363\353e+c\v\032f5\360%\261\244pi\023p\245\342H\365\341\2041c\026\360\235\307j\305)C\271\033\236SIx\254\f\202\377\221\030\035\221\020\303\217\350\220\006p\\\256\264\370\342Z\245\254O$g\323\221K\371C_\b\026\263Y\317\244\216G\321\360W\201\331\340\363}\250p\314\263\257D\267~\241\335[\021k\302\317\023&h\372\300\027\034\2650J\223\210\364\3322,\247\246\261?\036,\267qZb\247v\270\323%W\232\356>wc\252\026yv[\313/c\375gw\342\230%\024\021\004\353\355\213`f\331_\210\241\277\317\205\327\271\324H\260\"j\017\275\217b?h\006B\2072\003\225\2675i\247\202\0371\216\301\365\342xk\325\360&\361\2061\351\311\244f oH\325\'5#\033\373\004R\274\367KC\352\r\031*\006V\020\345(\037\370\340\t\020-\341\252v\336\253\314\375\332\t\373[\251N\274\337T\274(+\265+w\n\274\275g\367\030\212\\Xq\262C`!\267b\357\271\247\233\255,\313\250\f\203`\311\273)\267\366\346F\373\222\002\327\330\323\230\207Qu\200c\002XF\250.Q\370pG\207)\250\342\240\"\002\271\204Fv\241\226s&\376\355$\343\361\221\r\322\034\366ncj\320\343Z\346\361\246\216\t\307\365\372\"@\023\276\233}y\032\271\363\203\213\262\352\245\356\347K\")\377/\360\207\371\246nA\262!3|j\350\005}\231\300\2155\244\373\366j\354\234$\343\016\303t\220A\336\310\257dd\200D\204\200\375\2211DH\307\025\270VIgA\022\223\275{\203U\316*)\243\215L\256\031_iB\201\373\021\353\254,>a\266\001\251\272\032\347\303\214\312:d\032\'\371B\247\243\373\376\300H_\354\235\211f\267\0279\021\n\216D\326\340\037%\311\232yH\202\274\2120\345\001\2307,N\244\34266F\nOo\'\227\221\315\310\322\373\222E \022\341[\026De\200\t~\242\tE\223\016\006\230j#\244]6\204\227X\341B\312OJ\355^\254q8\241\256= \253\363%\224\245\3659\212\a\314\205\270+\243\233\272\264\030\357\204:\311\f[\340\23564i9\271\343\2155\n\240\254\325\366P\305/\'\331\206\236\341\201\260mU<\005\235\017r\234\374\210\311\261Sd\322\n\264\267\230\230 /\307+\020\215vF\340\214W\31