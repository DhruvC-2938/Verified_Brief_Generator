  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  ExternalLink,\n  ShieldCheck,\n  Calendar,\n  Globe,\n  Building,\n  GraduationCap,\n  FileText,\n  AlertCircle,\n  CheckCircle2,\n  Filter,\n  Search,\n} from \'lucide-react\';\nimport { SourceItem } from \'../types/index.ts\';\n\ninterface SourcesListProps {\n  sources: SourceItem[];\n  onOpenSourceModal?: (source: SourceItem) => void;\n}\n\nexport const SourcesList: React.FC<SourcesListProps> = ({\n  sources,\n  onOpenSourceModal,\n}) => {\n  const [selectedType, setSelectedType] = useState<string>(\'all\');\n  const [searchQuery, setSearchQuery] = useState(\'\');\n\n  const filteredSources = sources.filter((src) => {\n    if (selectedType !== \'all\' && src.sourceType.toLowerCase().replace(/ /g, \'_\') !== selectedType) {\n      return false;\n    }\n    if (searchQuery.trim()) {\n      const q = searchQuery.toLowerCase();\n      return (\n        src.title.toLowerCase().includes(q) ||\n        src.publisher.toLowerCase().includes(q) ||\n        src.domain.toLowerCase().includes(q) ||\n        src.excerpt.toLowerCase().includes(q)\n      );\n    }\n    return true;\n  });\n\n  const getSourceTypeIcon = (type: SourceItem[\'sourceType\']) => {\n    switch (type) {\n      case \'Government\':\n        return <Building className=\"w-4 h-4 text-emerald-600\" />;\n      case \'Educational\':\n      case \'Research Paper\':\n        return <GraduationCap className=\"w-4 h-4 text-indigo-600\" />;\n      case \'Official Report\':\n        return <FileText className=\"w-4 h-4 text-blue-600\" />;\n      default:\n        return <Globe className=\"w-4 h-4 text-slate-500\" />;\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Summary */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-5 rounded-2xl border border-slate-200\">\n        <div>\n          <h3 className=\"text-base font-serif font-bold text-slate-900\">\n            Discovered & Vetted Sources ({sources.length})\n          </h3>\n          <p className=\"text-xs text-slate-500 font-sans mt-0.5\">\n            Real live web citations verified against search grounding indices with deduplication and domain authority weighting.\n          </p>\n        </div>\n\n        {/* Filter by Type */}\n        <div className=\"flex items-center gap-2\">\n          <select\n            value={selectedType}\n            onChange={(e) => setSelectedType(e.target.value)}\n            className=\"text-xs font-medium bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-800\"\n          >\n            <option value=\"all\">All Source Types</option>\n            <option value=\"government\">Government (.gov / WHO)</option>\n            <option value=\"research_paper\">Peer-Reviewed Papers</option>\n            <option value=\"educational\">Educational (.edu)</option>\n            <option value=\"official_report\">Official Reports</option>\n            <option value=\"news\">News Organizations</option>\n          </select>\n        </div>\n      </div>\n\n      {/* Sources Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n        {filteredSources.map((source) => (\n          <div\n            key={source.id}\n            className=\"bg-white rounded-2xl border border-slate-200 p-5 shadow-xs hover:border-indigo-200 transition-all flex flex-col justify-between\"\n          >\n            <div>\n              {/* Top metadata row */}\n              <div className=\"flex items-center justify-between gap-2 mb-2.5\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"font-mono text-xs font-bold text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded border border-indigo-100\">\n                    [{source.id}]\n                  </span>\n                  <div className=\"flex items-center gap-1.5 text-xs text-slate-500\">\n                    {getSourceTypeIcon(source.sourceType)}\n                    <span className=\"font-medium text-slate-700\">{source.sourceType}</span>\n                  </div>\n                </div>\n\n                {/* Credibility Score */}\n                <div className=\"flex items-center gap-1.5 text-xs font-mono\">\n                  <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-600\" />\n                  <span className=\"font-semibold text-slate-800\">{source.credibilityScore}/100</span>\n                </div>\n              </div>\n\n              {/* Source Title */}\n              <h4 className=\"text-sm font-serif font-bold text-slate-900 leading-snug line-clamp-2 mb-2\">\n                {source.title}\n              </h4>\n\n              {/* Publication details & Freshness */}\n              <div className=\"flex items-center gap-2 text-xs text-slate-500 font-mono mb-3\">\n                <span className=\"text-slate-700 font-medium\">{source.publisher}</span>\n                <span aria-hidden=\"true\">\302\267</span>\n                <span className={source.publishedDate.includes(\'Unavailable\') ? \'text-amber-700\' : \'text-slate-600\'}>\n                  {source.publishedDate}\n                </span>\n              </div>\n\n              {/* Verbatim Excerpt */}\n              <div className=\"bg-slate-50 p-3 rounded-xl border border-slate-200/70 mb-4\">\n                <span className=\"text-[10px] font-mono uppercase tracking-wider text-slate-500 font-semibold block mb-1\">\n                  Retrieved Empirical Excerpt:\n                </span>\n                <p className=\"text-xs font-serif italic text-slate-700 line-clamp-3 leading-relaxed\">\n                  \"{source.excerpt}\"\n                </p>\n              </div>\n\n              {/* Credibility Notes */}\n              <div className=\"text-[11px] text-slate-500 font-sans leading-normal\">\n                <span className=\"font-semibold text-slate-600\">Authority appraisal: </span>\n                {source.credibilityNotes}\n              </div>\n            </div>\n\n            {/* Bottom URL Actions */}\n            <div className=\"pt-4 mt-4 border-t border-slate-100 flex items-center justify-between gap-3\">\n              <span className=\"text-[11px] font-mono text-slate-400 truncate max-w-[200px]\">\n                {source.domain}\n              </span>\n\n              <div className=\"flex items-center gap-2 shrink-0\">\n                {onOpenSourceModal && (\n                  <button\n                    onClick={() => onOpenSourceModal(source)}\n                    className=\"px-2.5 py-1 text-xs font-medium text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors\"\n                  >\n                    Details\n                  </button>\n                )}\n                <a\n                  href={source.url}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"inline-flex items-center gap-1 px-3 py-1 text-xs font-medium text-indigo-700 hover:text-indigo-900 bg-indigo-50 hover:bg-indigo-100 rounded-lg transition-colors\"\n                >\n                  <span>Open Source</span>\n                  <ExternalLink className=\"w-3 h-3\" />\n                </a>\n              </div>\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/SourcesList.tsx"
        }
        overwrite: true
      }
    }
